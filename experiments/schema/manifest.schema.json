{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "swe-term experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "papers",
    "hypothesis",
    "null_hypothesis",
    "independent_variable",
    "source",
    "environment",
    "model",
    "variants",
    "repetitions",
    "randomness",
    "metrics",
    "evaluator",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "status": {
      "enum": [
        "draft",
        "preregistered",
        "running",
        "complete",
        "rejected"
      ]
    },
    "papers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      }
    },
    "hypothesis": {
      "type": "string"
    },
    "null_hypothesis": {
      "type": "string"
    },
    "independent_variable": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "randomness": {
      "$ref": "#/$defs/randomness"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "evaluator": {
      "$ref": "#/$defs/evaluator"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "claim"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "revision",
        "content_digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "directory",
            "generated",
            "archive",
            "jj",
            "git"
          ]
        },
        "locator": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "content_digest": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "network",
        "network_justification",
        "allowed_env",
        "resources"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "process",
            "container",
            "external"
          ]
        },
        "network": {
          "enum": [
            "disabled",
            "loopback",
            "inherit"
          ]
        },
        "network_justification": {
          "type": "string"
        },
        "allowed_env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_parallelism",
        "max_output_bytes",
        "memory_bytes",
        "cpu_seconds"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallelism": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "cpu_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "provider",
        "id",
        "parameters",
        "prompt_digest",
        "tool_schema_digest"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "provider": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "prompt_digest": {
          "type": "string"
        },
        "tool_schema_digest": {
          "type": "string"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "command",
        "config"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "description": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "object"
        }
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "seeds",
        "justification"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deterministic",
            "seeded",
            "uncontrolled"
          ]
        },
        "seeds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "justification": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "acceptance_rule"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "acceptance_rule": {
          "type": "string"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "command",
        "rubric",
        "rubric_digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "command",
            "mixed"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rubric": {
          "type": "string"
        },
        "rubric_digest": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_runs",
        "curated"
      ],
      "properties": {
        "raw_runs": {
          "type": "string"
        },
        "curated": {
          "type": "string"
        }
      }
    }
  }
}
